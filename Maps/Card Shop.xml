		</Branch>
		<Branch num="1" name="Play PsyClash">/
			<Action>CardGame/Psy Clash Game Win,Psy Clash Game Lose,PlayerDeck,-FNAME2-,Red,20,1,-FNAME2- Deck,-FNAME2-,1,2</Action>
			<Action>EndConvImmediately/</Action>
		</Branch>
		<Branch num="2" name="Show Me Your Deck">-FNAME2-/-STR:Deck String-
			<Action>SetList/Alphabetized List</Action>
			<Action>CombineLists/Alphabetized List,-FNAME2- Deck</Action>
			<Action>SortList/Alphabetized List,false</Action>
			<Action>ListToString/Alphabetized List,;; ,Deck String</Action>
			<Reply>Return/NewBranch/0</Reply>
			<Reply>Upgrade Me/NamedBranch/Upgrade Me</Reply>
		</Branch>
		<Branch num="3" name="Upgrade Me">/
			<Action>Run/Upgrade Person,Person,-FNAME2-</Action>
			<Action>GoTo/BRANCH[Show Me Your Deck]</Action>
		</Branch>
	</Dialogue>

