	<Script>Place People
		<Action>Log/'Card Players' contains LASTINLIST[Card Players] members, 'Shop Staff' contains LASTINLIST[Shop Staff] members</Action>
		<Action>ShuffleList/Card Players</Action>
		<Action>ShuffleList/Shop Staff</Action>
