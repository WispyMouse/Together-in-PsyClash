	</Script>

	<Script>Place Person
		<Action>SpawnUnit/1,LIST{NPC Roster,-VAL:Roster Index-},0,-VAL:Roster Index-,Down</Action>
		<Action>SetVal/Roster Index,+:1</Action>
	</Script>

	<Script>Talk to Person Script
		<Action>Log/LOGMESSAGE: Loading conversation for -FNAME2-</Action>
		<Action>ChangeTriggerCharacter/Card Player</Action>
		<Action>ChangeSecondaryCharacter/-FNAME2-</Action>
		<Action>SetString/Person,-FNAME2-</Action>
		<Action>Log/LOGMESSAGE: The entity we are talking to is at -CHAR2X- and -CHAR2Y-.</Action>
		<Action>LoadConv/Talk to Person Conv,Card Player,-FNAME2-</Action>
	</Script>

	<Script>Player Table Talk Script
		<Action>Log/LOGMESSAGE: Find the closest character to -CHAR2X- and -CHAR2Y-</Action>
		<Action>SetVal/Closest Distance,=:99</Action>
		<Action>ForLoop/-ii-,0-LASTINLIST[Today Card Players],1,Run,Note If Closest,Character Index,-ii-</Action>
		<Action>Log/LOGMESSAGE: Closest character is -STR:Closest Character-</Action>
		<Action>ChangeTriggerCharacter/Card Player</Action>
		<Action>ChangeSecondaryCharacter/-STR:Closest Character-</Action>
		<Action>LoadConv/Talk to Person Conv,Card Player,-STR:Closest Character-</Action>
	</Script>

	<Script>Counter Talk Script
		<Action>LoadConv/Counter Talk Conv</Action>
	</Script>

	<Script>Note If Closest
		<Action>Log/LOGMESSAGE: Checking if character index -VAL:Character Index- name LIST{Today Card Players,-VAL:Character Index-} is the closest to -CHAR2X- and -CHAR2Y-</Action>
		<Action>GetDistToSpace/LIST{Today Card Players,-VAL:Character Index-},-CHAR2Y-,-CHAR2X-</Action>
		<Action>IfValRun/_Dist,l,-VAL:Closest Distance-,Set Current Character as Closest</Action>
	</Script>

	<Script>Set Current Character as Closest
		<Action>Log/LOGMESSAGE: Index -VAL:Character Index- Name LIST{Today Card Players,-VAL:Character Index-} is -VAL:_Dist- away, which is closer than previous best -VAL:Closest Distance-</Action>
		<Action>SetVal/Closest Distance,=:-VAL:_Dist-</Action>
		<Action>SetString/Closest Character,LIST{Today Card Players,-VAL:Character Index-}</Action>
		<Action>SetString/Person,-STR:Closest Character-</Action>
	</Script>

	<Script>Prompt Next Day Script
		<Action>LoadConv/Prompt Next Day Conv</Action>
	</Script>

