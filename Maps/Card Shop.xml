	<Dialogue trigger="None/" convID="Talk to Person Conv" r="true">
		<Branch num="0" name="">-FNAME2-/You're talking to me?
			<Action>ChangeTriggerCharacter/Card Player</Action>
			<Action>ChangeSecondaryCharacter/-STR:Person-</Action>
			<Action>AddPortrait/-FNAME2-,-FNAME2-,left</Action>
